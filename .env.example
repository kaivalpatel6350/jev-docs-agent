# Shared keys — copy to .env (never commit .env). Per-app logins go in projects/<name>/.env.

# Jev (step-by-step browser decisions). One OpenRouter key also covers Claude for the optional
# `agent.py docs` / `improve` / coach features. When Claude Desktop writes the docs (MCP), only Jev uses it.
OPENROUTER_API_KEY=

# Or direct keys instead of OpenRouter
# TYPESAFE_API_KEY=
# ANTHROPIC_API_KEY=

# Test logins normally live in projects/<name>/.env (+ .env.<profile> for other roles).
# Values set here or with docker -e / --env-file override those files, e.g. for another environment:
# LOGIN_USERNAME=
# LOGIN_PASSWORD=
# LOGIN_PROFILE=admin        # which projects/<name>/.env.<profile> to use by default
